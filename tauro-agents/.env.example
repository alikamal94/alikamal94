# Copy to .env and fill in. Never commit .env.

# Claude API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Telegram approval bot (from @BotFather). Start the bot, send it any message, and it replies with your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=
TELEGRAM_BACKUP_CHAT_ID=

# Prices: "sample" for testing, "tradingview" (your Mac, TradingView open), or "mt5" (Tauro's feed, Windows host)
TAURO_PRICE_PROVIDER=sample
# Command that starts the TradingView connector, copied from the Claude app's MCP settings
TAURO_TV_MCP_COMMAND=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional
# TAURO_CHROMIUM_PATH=/path/to/chrome
# TAURO_MAX_QA_RETRIES=2
# TAURO_MODEL_STRATEGIST=claude-opus-5-5
# TAURO_MODEL_QA=claude-opus-5-5
# TAURO_MODEL_COPYWRITER=claude-sonnet-5-5
# TAURO_MODEL_MARKET_BRIEF=claude-sonnet-5-5
# TAURO_MODEL_MARKET_SCAN=claude-haiku-4-5
