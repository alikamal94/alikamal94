//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  IFVG Sniper Model – STRATEGY version (for the TradingView Strategy Tester)
//  Same signals as the indicator; adds real orders: risk-based size, 50% at TP1, rest at TP2, SL → BE.
//  1. Liquidity sweep   – price wicks through a swing / previous-day high-low and closes back inside
//  2. V-shape recovery  – fast displacement away from the sweep extreme (× ATR)
//  3. CISD              – close through the open of the delivery series that made the extreme
//  4. IFVG              – an opposing FVG is closed through by a displacement candle → sniper zone
//  5. Retest + sweep    – price returns into the IFVG, sweeps minor liquidity and holds → entry
//  6. Targets           – fixed 1R / 2R (default) with a draw on liquidity required beyond TP1
//  Filters              – higher-timeframe bias, London / New York killzones, max stop size,
//                         discount / premium entry, daily trade & loss limits, one position at a time
// ─────────────────────────────────────────────────────────────────────────────
strategy("IFVG Sniper Model – Strategy", "IFVG Sniper S", overlay = true, max_bars_back = 500,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
     initial_capital = 10000, pyramiding = 0, process_orders_on_close = true,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0, slippage = 0)

// ───────────────────────── Inputs ─────────────────────────
const string G0 = "0 · High-Probability Filters"
useHtf    = input.bool(true, "Trade with higher-timeframe bias", group = G0,
     tooltip = "Longs only when the HTF close is above a rising EMA, shorts only below a falling EMA (last closed HTF bar, no repaint).")
htfTf     = input.timeframe("60", "HTF", group = G0, inline = "htf")
htfEmaLen = input.int(50, "EMA", minval = 1, group = G0, inline = "htf")
useKz     = input.bool(true, "Entries only inside killzones", group = G0)
kz1       = input.session("0200-0500", "London", group = G0, inline = "kz")
kz2       = input.session("0700-1100", "New York", group = G0, inline = "kz")
kzTz      = input.string("America/New_York", "Killzone timezone", group = G0)
dispBody  = input.float(0.5, "Min body % of IFVG inversion candle", minval = 0, maxval = 1, step = 0.05, group = G0,
     tooltip = "The candle that closes through the FVG must be a displacement candle (body / range). 0 disables.")
pdMin     = input.float(0.5, "Min retracement into the V leg", minval = 0, maxval = 1, step = 0.05, group = G0,
     tooltip = "Entry must sit at least this deep in the range from the sweep extreme to the V high (bull) / low (bear). 0.5 = discount for longs, premium for shorts. 0 disables.")
maxDay    = input.int(2, "Max trades per day", minval = 1, group = G0, inline = "day")
maxLossDay = input.int(1, "Stop after N losses", minval = 1, group = G0, inline = "day")
maxSlAtr  = input.float(2.0, "Skip entry if stop > N × ATR", minval = 0.2, step = 0.1, group = G0)
minSlAtr  = input.float(0.3, "Minimum stop size (× ATR)", minval = 0, step = 0.05, group = G0,
     tooltip = "Stops tighter than this get widened so normal noise does not tag them.")

const string G1 = "1 · Liquidity Sweep"
swingLen  = input.int(8, "Liquidity swing length", minval = 2, group = G1,
     tooltip = "Bars on each side that define a swing high/low (a resting liquidity pool). Higher = only major liquidity.")
usePdl    = input.bool(true, "Add previous-day high / low as liquidity", group = G1)
useAsia   = input.bool(true, "Add Asia session high / low as liquidity", group = G1, inline = "asia")
asiaSess  = input.session("2000-0000", "", group = G1, inline = "asia")
maxPools  = input.int(30, "Max pools tracked per side", minval = 5, maxval = 100, group = G1)
showPools = input.bool(true, "Show resting liquidity levels", group = G1)

const string G2 = "2 · V-Shape Recovery"
vMaxBars  = input.int(6, "Max bars from extreme → recovery", minval = 1, group = G2)
vAtrMult  = input.float(1.5, "Recovery displacement (× ATR)", minval = 0.1, step = 0.1, group = G2)
atrLen    = input.int(14, "ATR length", minval = 1, group = G2)

const string G3 = "3 · CISD + IFVG"
alignBars = input.int(12, "Max bars sweep → CISD & IFVG", minval = 1, group = G3)
cisdScan  = input.int(15, "CISD candle scan depth", minval = 1, maxval = 100, group = G3)
fvgLook   = input.int(20, "FVG may form up to N bars before sweep", minval = 1, group = G3)
fvgMinAtr = input.float(0.1, "Min FVG size (× ATR)", minval = 0, step = 0.05, group = G3)

const string G4 = "4 · Retest + Second Sweep"
retestMax = input.int(16, "Max bars to wait for retest", minval = 1, group = G4)
minorLen  = input.int(3, "Retest sweep lookback (bars)", minval = 1, group = G4,
     tooltip = "On the retest, price must take the low (bull) / high (bear) of the previous N bars and close back.")

const string G5 = "5 · Targets & Management"
tpMode     = input.string("Fixed R:R", "Target mode", options = ["Fixed R:R", "Liquidity (capped at R:R)"], group = G5,
     tooltip = "Fixed R:R: TP1 / TP2 exactly at the R multiples below.\nLiquidity (capped): nearest draw on liquidity, never further than the R multiples.")
rr1        = input.float(1.0, "TP1 (R)", minval = 0.25, step = 0.25, group = G5, inline = "rr")
rr2        = input.float(2.0, "TP2 (R)", minval = 0.5, step = 0.25, group = G5, inline = "rr")
requireDol = input.bool(true, "Require draw on liquidity beyond TP1", group = G5,
     tooltip = "Only enter when an untouched liquidity pool sits at least TP1 away in the trade direction.")
slBuf      = input.float(0.1, "SL buffer (× ATR)", minval = 0, step = 0.05, group = G5)
partialPct = input.float(50, "Close % at TP1", minval = 0, maxval = 100, step = 5, group = G5)
beAfterTp1 = input.bool(true, "Move SL to entry after TP1", group = G5)
tradeMax   = input.int(96, "Close trade after N bars", minval = 1, group = G5)

const string G6 = "Display"
showBull  = input.bool(true, "Bullish setups", group = G6, inline = "d")
showBear  = input.bool(true, "Bearish setups", group = G6, inline = "d")
bullCol   = input.color(#089981, "Bull", group = G6, inline = "c")
bearCol   = input.color(#F23645, "Bear", group = G6, inline = "c")
tgtCol    = input.color(#2962FF, "Targets", group = G6, inline = "c")
slCol     = input.color(#FF9800, "Stop", group = G6, inline = "c")
showStats = input.bool(true, "Show stats table", group = G6)

// ───────────────────────── Core series ─────────────────────────
atr       = ta.atr(atrLen)
minorLow  = ta.lowest(low, minorLen)[1]
minorHigh = ta.highest(high, minorLen)[1]
ph        = ta.pivothigh(high, swingLen, swingLen)
pl        = ta.pivotlow(low, swingLen, swingLen)

// Higher-timeframe bias from the last CLOSED HTF bar (lookahead + [1] = no repaint)
htfData() =>
    float e = ta.ema(close, htfEmaLen)
    [close[1], e[1], e[2]]
[htfClose, htfEma, htfEmaPrev] = request.security(syminfo.tickerid, htfTf, htfData(), lookahead = barmerge.lookahead_on)
bool bullBias = not useHtf or (htfClose > htfEma and htfEma > htfEmaPrev)
bool bearBias = not useHtf or (htfClose < htfEma and htfEma < htfEmaPrev)

// Killzones
bool inKz = not useKz or not na(time(timeframe.period, kz1, kzTz)) or not na(time(timeframe.period, kz2, kzTz))

// Displacement candle (body share of range) for the IFVG inversion
float rng     = high - low
bool  bullDisp = close > open and rng > 0 and (close - open) / rng >= dispBody
bool  bearDisp = close < open and rng > 0 and (open - close) / rng >= dispBody

// ───────────────────────── Liquidity pools ─────────────────────────
var array<float> bslPx  = array.new<float>()   // buy-side liquidity (swing highs)
var array<int>   bslBar = array.new<int>()
var array<line>  bslLn  = array.new<line>()
var array<float> sslPx  = array.new<float>()   // sell-side liquidity (swing lows)
var array<int>   sslBar = array.new<int>()
var array<line>  sslLn  = array.new<line>()

addPool(array<float> px, array<int> bx, array<line> ln, float p, int b) =>
    line l = na
    if showPools
        l := line.new(b, p, bar_index, p, color = color.new(color.gray, 40), style = line.style_dotted, extend = extend.right)
    px.push(p)
    bx.push(b)
    ln.push(l)
    if px.size() > maxPools
        px.shift()
        bx.shift()
        line.delete(ln.shift())

// Removes every pool traded through this bar. Returns the most extreme pool that was
// swept AND reclaimed (wick through, close back) – d = 1 checks lows, d = -1 checks highs.
scanSweeps(array<float> px, array<int> bx, array<line> ln, int d) =>
    float lvl = na
    int   lb  = na
    int   n   = px.size()
    if n > 0
        for i = n - 1 to 0
            float p = px.get(i)
            bool taken = d == 1 ? low < p : high > p
            if taken
                bool reclaimed = d == 1 ? close > p : close < p
                if reclaimed and (na(lvl) or d * (lvl - p) > 0)
                    lvl := p
                    lb  := bx.get(i)
                line l = ln.get(i)
                if not na(l)
                    line.set_x2(l, bar_index)
                    line.set_extend(l, extend.none)
                px.remove(i)
                bx.remove(i)
                ln.remove(i)
    [lvl, lb]

// ───────────────────────── Fair value gaps ─────────────────────────
var array<float> bearFvgTop = array.new<float>()   // bearish FVGs → become bullish IFVGs
var array<float> bearFvgBot = array.new<float>()
var array<int>   bearFvgBar = array.new<int>()
var array<float> bullFvgTop = array.new<float>()   // bullish FVGs → become bearish IFVGs
var array<float> bullFvgBot = array.new<float>()
var array<int>   bullFvgBar = array.new<int>()

addFvg(array<float> top, array<float> bot, array<int> bx, float t, float b, int x) =>
    top.push(t)
    bot.push(b)
    bx.push(x)
    if top.size() > 100
        top.shift()
        bot.shift()
        bx.shift()

// Removes every FVG closed through this bar. Returns the most recent inverted FVG that
// formed at/after minBar. d = 1 → bearish FVG closed above, d = -1 → bullish FVG closed below.
scanInversions(array<float> top, array<float> bot, array<int> bx, int d, int minBar) =>
    float zt   = na
    float zb   = na
    int   zbar = na
    int   n    = top.size()
    if n > 0
        for i = n - 1 to 0
            bool inverted = d == 1 ? close > top.get(i) : close < bot.get(i)
            if inverted
                int fb = bx.get(i)
                if fb >= minBar and (na(zbar) or fb > zbar)
                    zt   := top.get(i)
                    zb   := bot.get(i)
                    zbar := fb
                top.remove(i)
                bot.remove(i)
                bx.remove(i)
    [zt, zb, zbar]

// CISD reference: open of the earliest candle in the consecutive opposing series that
// delivered price into the current extreme (bull: down-close candles, bear: up-close).
cisdLevel(int d) =>
    float lvl = na
    int   lb  = na
    bool  run = false
    for i = 0 to cisdScan
        bool opp = d == 1 ? close[i] < open[i] : close[i] > open[i]
        if opp
            lvl := open[i]
            lb  := bar_index - i
            run := true
        else if run
            break
    [lvl, lb]

// Draw on liquidity: nearest two untouched pools in trade direction, at least minDist away.
findTargets(int d, float entry, float minDist) =>
    array<float> pools = d == 1 ? bslPx : sslPx
    float t1 = na
    float t2 = na
    for p in pools
        if d * (p - entry) >= minDist
            if na(t1) or d * (t1 - p) > 0
                t2 := t1
                t1 := p
            else if p != t1 and (na(t2) or d * (t2 - p) > 0)
                t2 := p
    [t1, t2]

// ───────────────────────── Setup state machine ─────────────────────────
// st: 0 idle · 1 swept (waiting V + CISD + IFVG) · 2 IFVG armed (waiting retest) · 3 in trade
type Setup
    int   dir
    int   st       = 0
    float lvl
    int   lvlBar
    int   sweepBar
    float ext
    int   extBar
    bool  vDone    = false
    int   vBar
    float vPx
    float cisd
    int   cisdBar
    bool  cisdDone = false
    int   cisdConfBar
    bool  zDone    = false
    float zTop
    float zBot
    int   zBar
    int   armBar
    float far        // V-leg extreme in trade direction (for discount / premium)
    float entry
    float sl
    float tp1
    float tp2
    float risk
    float r1
    float r2
    bool  tp1Hit   = false
    int   entryBar
    box   zBox
    line  lE
    line  lS
    line  lT1
    line  lT2
    label bS
    label bT1
    label bT2

method reset(Setup s) =>
    s.st       := 0
    s.vDone    := false
    s.cisdDone := false
    s.zDone    := false
    s.tp1Hit   := false
    s.zBox     := na
    s.lE       := na
    s.lS       := na
    s.lT1      := na
    s.lT2      := na
    s.bS       := na
    s.bT1      := na
    s.bT2      := na
    true

method start(Setup s, float lvl, int lvlBar) =>
    float adv = s.dir == 1 ? low : high
    if s.st == 0
        [c, cb] = cisdLevel(s.dir)
        s.st       := 1
        s.lvl      := lvl
        s.lvlBar   := lvlBar
        s.sweepBar := bar_index
        s.ext      := adv
        s.extBar   := bar_index
        s.cisd     := c
        s.cisdBar  := cb
        s.far      := s.dir == 1 ? high : low
    else if s.st == 1 and s.dir * (s.lvl - lvl) > 0
        s.lvl    := lvl
        s.lvlBar := lvlBar
    true

method setTradeX(Setup s, int x) =>
    line.set_x2(s.lE, x)
    line.set_x2(s.lS, x)
    line.set_x2(s.lT1, x)
    line.set_x2(s.lT2, x)
    label.set_x(s.bS, x)
    label.set_x(s.bT1, x)
    label.set_x(s.bT2, x)
    true

// bias: HTF bias agrees with this direction · allow: killzone, daily limits and no open opposite trade
method update(Setup s, float atrV, float minorLvl, float zt, float zb, int zbar, bool bias, bool allow) =>
    int   d   = s.dir
    color c   = d == 1 ? bullCol : bearCol
    float adv = d == 1 ? low : high
    float fav = d == 1 ? high : low
    bool evArm   = false
    bool evEntry = false
    bool evTp1   = false
    bool evTp2   = false
    bool evSl    = false
    bool evBe    = false
    float resR   = na     // realised R when the trade closes on this bar
    float part   = partialPct / 100

    if s.st == 1
        // New extreme → any partial confirmation is void, rebuild from the new low/high
        if d * (s.ext - adv) > 0
            [cl, cb] = cisdLevel(d)
            s.ext      := adv
            s.extBar   := bar_index
            s.vDone    := false
            s.cisdDone := false
            s.zDone    := false
            s.cisd     := cl
            s.cisdBar  := cb
            s.far      := fav
        s.far := na(s.far) or d * (fav - s.far) > 0 ? fav : s.far
        if not na(zbar)
            s.zTop  := zt
            s.zBot  := zb
            s.zBar  := zbar
            s.zDone := true
        if not s.vDone and bar_index - s.extBar <= vMaxBars and d * (fav - s.ext) >= vAtrMult * atrV and d * (close - s.lvl) > 0
            s.vDone := true
            s.vBar  := bar_index
            s.vPx   := fav
        if not s.cisdDone and not na(s.cisd) and d * (close - s.cisd) > 0
            s.cisdDone    := true
            s.cisdConfBar := bar_index

        if s.vDone and s.cisdDone and s.zDone
            s.st     := 2
            s.armBar := bar_index
            evArm    := true
            line.new(s.lvlBar, s.lvl, s.sweepBar, s.lvl, color = c, style = line.style_dashed)
            label.new(s.extBar, s.ext, d == 1 ? "SSL sweep" : "BSL sweep", color = color(na), textcolor = c,
                 style = d == 1 ? label.style_label_up : label.style_label_down, size = size.small)
            label.new(s.vBar, s.vPx, "V", color = color(na), textcolor = c,
                 style = d == 1 ? label.style_label_down : label.style_label_up, size = size.small)
            line.new(s.cisdBar, s.cisd, s.cisdConfBar, s.cisd, color = c, width = 2)
            label.new(s.cisdConfBar, s.cisd, "CISD", color = color(na), textcolor = c,
                 style = label.style_label_left, size = size.small)
            s.zBox := box.new(s.zBar, s.zTop, bar_index, s.zBot, border_color = c, bgcolor = color.new(c, 80),
                 text = "⌖ IFVG", text_color = c, text_size = size.small, text_halign = text.align_right)
        else if bar_index - s.sweepBar > alignBars or (not s.vDone and bar_index - s.extBar > vMaxBars)
            s.reset()

    else if s.st == 2
        float zNear = d == 1 ? s.zTop : s.zBot
        float zFar  = d == 1 ? s.zBot : s.zTop
        box.set_right(s.zBox, bar_index)
        s.far := d * (fav - s.far) > 0 ? fav : s.far
        if bar_index > s.armBar
            bool broke   = d * (close - zFar) < 0 or d * (adv - s.ext) < 0
            bool expired = bar_index - s.armBar > retestMax
            bool touched = d * (adv - zNear) <= 0
            bool sweep2  = d * (adv - minorLvl) < 0 and d * (close - minorLvl) > 0
            bool holds   = d * (close - zFar) >= 0
            if broke or expired
                box.set_bgcolor(s.zBox, color.new(color.gray, 85))
                box.set_border_color(s.zBox, color.gray)
                box.set_text_color(s.zBox, color.gray)
                s.reset()
            else if touched and sweep2 and holds and bias and allow
                float entry = close
                float legSz = math.abs(s.far - s.ext)
                float depth = legSz > 0 ? d * (s.far - entry) / legSz : 0.0
                float risk  = math.max(math.abs(entry - (adv - d * slBuf * atrV)), minSlAtr * atrV)
                [dol, dol2] = findTargets(d, entry, rr1 * risk)
                bool okSize = risk <= maxSlAtr * atrV
                bool okDol  = not requireDol or not na(dol)
                bool okPd   = depth >= pdMin
                // A retest that fails the stop-size / DOL / discount filters is skipped; the zone stays armed.
                if okSize and okDol and okPd
                    s.st       := 3
                    s.entryBar := bar_index
                    s.entry    := entry
                    s.risk     := risk
                    s.sl       := entry - d * risk
                    float cap1 = entry + d * rr1 * risk
                    float cap2 = entry + d * rr2 * risk
                    if tpMode == "Fixed R:R"
                        s.tp1 := cap1
                        s.tp2 := cap2
                    else
                        [t1, t2] = findTargets(d, entry, 0.5 * risk)
                        s.tp1 := na(t1) or d * (t1 - cap1) > 0 ? cap1 : t1
                        s.tp2 := na(t2) or d * (t2 - cap2) > 0 ? cap2 : t2
                        if d * (s.tp2 - s.tp1) <= 0
                            s.tp2 := entry + d * math.max(rr2 * risk, math.abs(s.tp1 - entry) + 0.5 * risk)
                    s.r1 := math.abs(s.tp1 - entry) / risk
                    s.r2 := math.abs(s.tp2 - entry) / risk
                    evEntry := true

                    int x2 = bar_index + 5
                    string tip = "Entry " + str.tostring(s.entry, format.mintick) +
                         "\nSL " + str.tostring(s.sl, format.mintick) +
                         "\nTP1 " + str.tostring(s.tp1, format.mintick) + " (" + str.tostring(s.r1, "#.##") + "R)" +
                         "\nTP2 " + str.tostring(s.tp2, format.mintick) + " (" + str.tostring(s.r2, "#.##") + "R)" +
                         "\nDraw on liquidity " + (na(dol) ? "none beyond TP1" : str.tostring(dol, format.mintick)) +
                         "\nRetracement " + str.tostring(depth * 100, "#") + "% of V leg"
                    label.new(bar_index, adv, d == 1 ? "BUY" : "SELL", color = c,
                         textcolor = color.white, style = d == 1 ? label.style_label_up : label.style_label_down,
                         size = size.small, tooltip = tip)
                    box.set_border_width(s.zBox, 2)
                    s.lE  := line.new(bar_index, s.entry, x2, s.entry, color = c, width = 2)
                    s.lS  := line.new(bar_index, s.sl, x2, s.sl, color = slCol, style = line.style_dashed)
                    s.lT1 := line.new(bar_index, s.tp1, x2, s.tp1, color = tgtCol, style = line.style_dashed)
                    s.lT2 := line.new(bar_index, s.tp2, x2, s.tp2, color = tgtCol)
                    s.bS  := label.new(x2, s.sl, "SL", color = color(na), textcolor = slCol,
                         style = label.style_label_left, size = size.small)
                    s.bT1 := label.new(x2, s.tp1, "TP1 " + str.tostring(s.r1, "#.#") + "R", color = color(na),
                         textcolor = tgtCol, style = label.style_label_left, size = size.small)
                    s.bT2 := label.new(x2, s.tp2, "TP2 " + str.tostring(s.r2, "#.#") + "R", color = color(na),
                         textcolor = tgtCol, style = label.style_label_left, size = size.small)

    else if s.st == 3
        if bar_index > s.entryBar
            s.setTradeX(bar_index + 5)
            bool hitSl  = d * (adv - s.sl) <= 0
            bool hitTp1 = d * (fav - s.tp1) >= 0
            bool hitTp2 = d * (fav - s.tp2) >= 0
            // Conservative: if SL and a target print on the same bar, the stop is assumed first
            if hitSl
                if s.tp1Hit
                    evBe := true
                    resR := part * s.r1 + (1 - part) * d * (s.sl - s.entry) / s.risk
                else
                    evSl := true
                    resR := -1.0
                label.new(bar_index, adv, s.tp1Hit ? (beAfterTp1 ? "BE" : "SL after TP1") : "SL ✕", color = color(na),
                     textcolor = slCol, style = d == 1 ? label.style_label_up : label.style_label_down, size = size.small)
                s.setTradeX(bar_index)
                s.reset()
            else if hitTp2
                if not s.tp1Hit
                    evTp1 := true
                evTp2 := true
                resR  := part * s.r1 + (1 - part) * s.r2
                label.new(bar_index, s.tp2, "TP2 ✓", color = color(na), textcolor = tgtCol,
                     style = d == 1 ? label.style_label_down : label.style_label_up, size = size.small)
                s.setTradeX(bar_index)
                s.reset()
            else
                if hitTp1 and not s.tp1Hit
                    s.tp1Hit := true
                    evTp1    := true
                    label.new(bar_index, s.tp1, "TP1 ✓", color = color(na), textcolor = tgtCol,
                         style = d == 1 ? label.style_label_down : label.style_label_up, size = size.small)
                    if beAfterTp1
                        s.sl := s.entry
                        line.set_y1(s.lS, s.entry)
                        line.set_y2(s.lS, s.entry)
                        label.set_y(s.bS, s.entry)
                        label.set_text(s.bS, "SL → BE")
                if bar_index - s.entryBar >= tradeMax
                    float openR = d * (close - s.entry) / s.risk
                    resR := s.tp1Hit ? part * s.r1 + (1 - part) * openR : openR
                    label.new(bar_index, close, "Time exit " + str.tostring(resR, "#.##") + "R", color = color(na),
                         textcolor = color.gray, style = label.style_label_left, size = size.small)
                    s.setTradeX(bar_index)
                    s.reset()

    [evArm, evEntry, evTp1, evTp2, evSl, evBe, resR]

// ───────────────────────── Engine ─────────────────────────
var Setup bull = Setup.new(1)
var Setup bear = Setup.new(-1)

// 1 · register new liquidity pools
if not na(ph)
    addPool(bslPx, bslBar, bslLn, ph, bar_index - swingLen)
if not na(pl)
    addPool(sslPx, sslBar, sslLn, pl, bar_index - swingLen)

// previous-day high / low become liquidity pools at the start of each new day
var float dH  = na
var float dL  = na
var int   dHB = na
var int   dLB = na
if timeframe.change("D")
    if usePdl and not na(dH)
        addPool(bslPx, bslBar, bslLn, dH, dHB)
        addPool(sslPx, sslBar, sslLn, dL, dLB)
    dH  := high
    dHB := bar_index
    dL  := low
    dLB := bar_index
else
    if na(dH) or high > dH
        dH  := high
        dHB := bar_index
    if na(dL) or low < dL
        dL  := low
        dLB := bar_index

// Asia session high / low become liquidity pools when the session ends
bool inAsia = not na(time(timeframe.period, asiaSess, kzTz))
var float aH  = na
var float aL  = na
var int   aHB = na
var int   aLB = na
if inAsia
    if not inAsia[1] or na(aH)
        aH  := high
        aHB := bar_index
        aL  := low
        aLB := bar_index
    else
        if high > aH
            aH  := high
            aHB := bar_index
        if low < aL
            aL  := low
            aLB := bar_index
else if inAsia[1] and useAsia and not na(aH)
    addPool(bslPx, bslBar, bslLn, aH, aHB)
    addPool(sslPx, sslBar, sslLn, aL, aLB)

// daily trade / loss limits (reset with the trading day)
var int dayTrades = 0
var int dayLosses = 0
if timeframe.change("D")
    dayTrades := 0
    dayLosses := 0
bool dayOk = dayTrades < maxDay and dayLosses < maxLossDay

// 2 · liquidity sweeps start (or deepen) a setup
[sslLvl, sslB] = scanSweeps(sslPx, sslBar, sslLn, 1)
[bslLvl, bslB] = scanSweeps(bslPx, bslBar, bslLn, -1)
if showBull and bullBias and not na(sslLvl)
    bull.start(sslLvl, sslB)
if showBear and bearBias and not na(bslLvl)
    bear.start(bslLvl, bslB)

// 3 · FVG inversions (only FVGs formed around the sweep, inverted by a displacement candle)
int bullMin = bull.st == 1 and bullDisp ? bull.sweepBar - fvgLook : bar_index + 1
int bearMin = bear.st == 1 and bearDisp ? bear.sweepBar - fvgLook : bar_index + 1
[bzt, bzb, bzbar] = scanInversions(bearFvgTop, bearFvgBot, bearFvgBar, 1, bullMin)
[szt, szb, szbar] = scanInversions(bullFvgTop, bullFvgBot, bullFvgBar, -1, bearMin)

if high < low[2] and low[2] - high >= fvgMinAtr * atr
    addFvg(bearFvgTop, bearFvgBot, bearFvgBar, low[2], high, bar_index - 1)
if low > high[2] and low - high[2] >= fvgMinAtr * atr
    addFvg(bullFvgTop, bullFvgBot, bullFvgBar, low, high[2], bar_index - 1)

// 4 · advance state machines
// one position at a time: a direction may not enter while the other is in a trade
[bArm, bEntry, bTp1, bTp2, bSl, bBe, bR] = bull.update(atr, minorLow, bzt, bzb, bzbar, bullBias, inKz and dayOk and bear.st != 3)
[sArm, sEntry, sTp1, sTp2, sSl, sBe, sR] = bear.update(atr, minorHigh, szt, szb, szbar, bearBias, inKz and dayOk and bull.st != 3)
dayTrades += (bEntry ? 1 : 0) + (sEntry ? 1 : 0)
dayLosses += (not na(bR) and bR < 0 ? 1 : 0) + (not na(sR) and sR < 0 ? 1 : 0)

// ───────────────────────── Stats ─────────────────────────
var int   nTrades = 0
var int   nClosed = 0
var int   nWin    = 0
var int   nTp1    = 0
var int   nTp2    = 0
var int   nLoss   = 0
var float netR    = 0.0
nTrades += (bEntry ? 1 : 0) + (sEntry ? 1 : 0)
nTp1    += (bTp1 ? 1 : 0) + (sTp1 ? 1 : 0)
nTp2    += (bTp2 ? 1 : 0) + (sTp2 ? 1 : 0)
nLoss   += (bSl ? 1 : 0) + (sSl ? 1 : 0)
for r in array.from(bR, sR)
    if not na(r)
        nClosed += 1
        nWin    += r > 0 ? 1 : 0
        netR    += r

statRow(table t, int row, string k, string v, color c) =>
    table.cell(t, 0, row, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, row, v, text_color = c, text_size = size.small, text_halign = text.align_right)

pct(int a, int b) => b > 0 ? str.tostring(100.0 * a / b, "#") + "%" : "–"

stateName(Setup s) =>
    s.st == 0 ? "Idle" : s.st == 1 ? "Swept – waiting V/CISD/IFVG" : s.st == 2 ? "IFVG armed – waiting retest" : "In trade"

var table stats = table.new(position.top_right, 2, 13, bgcolor = color.new(#131722, 10), border_width = 1)
if showStats and barstate.islast
    table.cell(stats, 0, 0, "IFVG Sniper · " + timeframe.period + (timeframe.period == "15" ? "" : "  (tuned for 15)"),
         text_color = color.white, text_size = size.small)
    table.merge_cells(stats, 0, 0, 1, 0)
    statRow(stats, 1, "Trades closed", str.tostring(nClosed) + " / " + str.tostring(nTrades), color.white)
    statRow(stats, 2, "Win rate (R > 0)", pct(nWin, nClosed), tgtCol)
    statRow(stats, 3, "TP1 reached", pct(nTp1, nClosed), tgtCol)
    statRow(stats, 4, "TP2 reached", pct(nTp2, nClosed), tgtCol)
    statRow(stats, 5, "Stopped before TP1", pct(nLoss, nClosed), slCol)
    statRow(stats, 6, "Net R", str.tostring(netR, "#.##"), netR >= 0 ? tgtCol : slCol)
    statRow(stats, 7, "Avg R / trade", nClosed > 0 ? str.tostring(netR / nClosed, "#.##") : "–", netR >= 0 ? tgtCol : slCol)
    statRow(stats, 8, "HTF bias", not useHtf ? "off" : bullBias ? "Bullish" : bearBias ? "Bearish" : "Neutral – no trades",
         not useHtf ? color.gray : bullBias ? bullCol : bearBias ? bearCol : color.gray)
    statRow(stats, 9, "Killzone", not useKz ? "off" : inKz ? "Open" : "Closed", inKz ? tgtCol : color.gray)
    statRow(stats, 10, "Today", str.tostring(dayTrades) + " trades · " + str.tostring(dayLosses) + " losses" + (dayOk ? "" : " – done"),
         dayOk ? color.white : slCol)
    statRow(stats, 11, "Bull", stateName(bull), bullCol)
    statRow(stats, 12, "Bear", stateName(bear), bearCol)

// ───────────────────────── Data window ─────────────────────────
plot(bull.st == 3 ? bull.entry : na, "Bull entry", bullCol, display = display.data_window)
plot(bull.st == 3 ? bull.sl    : na, "Bull SL",    slCol,   display = display.data_window)
plot(bull.st == 3 ? bull.tp1   : na, "Bull TP1",   tgtCol,  display = display.data_window)
plot(bull.st == 3 ? bull.tp2   : na, "Bull TP2",   tgtCol,  display = display.data_window)
plot(bear.st == 3 ? bear.entry : na, "Bear entry", bearCol, display = display.data_window)
plot(bear.st == 3 ? bear.sl    : na, "Bear SL",    slCol,   display = display.data_window)
plot(bear.st == 3 ? bear.tp1   : na, "Bear TP1",   tgtCol,  display = display.data_window)
plot(bear.st == 3 ? bear.tp2   : na, "Bear TP2",   tgtCol,  display = display.data_window)

// ───────────────────────── Orders ─────────────────────────
const string G7 = "Strategy"
riskPct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 10, step = 0.1, group = G7)

qtyFor(float risk) => risk > 0 ? strategy.equity * riskPct / 100 / (risk * syminfo.pointvalue) : 0.0

// entries fill at the close of the signal bar (process_orders_on_close), exactly like the indicator
if bEntry and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty = qtyFor(bull.risk))
if sEntry and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty = qtyFor(bear.risk))

// exits are re-sent every bar so the stop follows the indicator (moves to entry after TP1)
if bull.st == 3
    if not bull.tp1Hit and partialPct > 0
        strategy.exit("Long TP1", "Long", qty_percent = partialPct, stop = bull.sl, limit = bull.tp1)
    strategy.exit("Long TP2", "Long", stop = bull.sl, limit = bull.tp2)
if bear.st == 3
    if not bear.tp1Hit and partialPct > 0
        strategy.exit("Short TP1", "Short", qty_percent = partialPct, stop = bear.sl, limit = bear.tp1)
    strategy.exit("Short TP2", "Short", stop = bear.sl, limit = bear.tp2)

// time exit / safety sync with the indicator's trade state
if strategy.position_size > 0 and bull.st != 3
    strategy.close("Long", comment = "Time exit")
if strategy.position_size < 0 and bear.st != 3
    strategy.close("Short", comment = "Time exit")

// ───────────────────────── Alerts ─────────────────────────

if bEntry
    alert("IFVG Sniper BUY " + syminfo.ticker + " | entry " + str.tostring(bull.entry, format.mintick) +
         " | SL " + str.tostring(bull.sl, format.mintick) + " | TP1 " + str.tostring(bull.tp1, format.mintick) +
         " | TP2 " + str.tostring(bull.tp2, format.mintick), alert.freq_once_per_bar_close)
if sEntry
    alert("IFVG Sniper SELL " + syminfo.ticker + " | entry " + str.tostring(bear.entry, format.mintick) +
         " | SL " + str.tostring(bear.sl, format.mintick) + " | TP1 " + str.tostring(bear.tp1, format.mintick) +
         " | TP2 " + str.tostring(bear.tp2, format.mintick), alert.freq_once_per_bar_close)
