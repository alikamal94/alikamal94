// =====================================================================================================================
// CONSTANTS AND TYPES
// =====================================================================================================================
string TZ_NY = "America/New_York"
string TZ_LDN = "Europe/London"
int MAX_POOL = 64
color C_BUY = color.new(color.green, 0)
color C_SELL = color.new(color.red, 0)
color C_NEUT = color.new(color.gray, 0)

type Liq
    float price
    int kind
    int born
    int pierceBar
    float pierceExt

type Setup
    int stage = 0
    int sweepBar = 0
    float ext = na
    float sweepQ = 0.0
    int sweepKind = 0
    float mssLvl = na
    float dispStr = 0.0
    int mssBar = 0
    float mssMargin = 0.0
    float fvgTop = na
    float fvgBot = na
    int fvgBar = -1
    float fvgSz = 0.0
    float fvgOrg = na
    bool touched = false
    float obLo = na
    float obHi = na
    float lastSH = na
    float p1h = na
    float p4h = na
    float pDay = na

// Liquidity grade by pool kind: 1 internal swing, 2 external swing, 3 equal highs/lows, 4 prev 1H, 5 prev 4H,
// 6 prev session, 7 prev day.
f_kindW(int k) =>
    switch k
        1 => 0.35
        2 => 0.65
        3 => 0.80
        4 => 0.55
        5 => 0.80
        6 => 0.90
        7 => 1.00
        => 0.0

f_kindName(int k) =>
    switch k
        1 => "internal swing"
        2 => "external swing"
        3 => "equal H/L"
        4 => "prev 1H"
        5 => "prev 4H"
        6 => "prev session"
        7 => "prev day"
        => "-"

f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

// =====================================================================================================================
// HIGHER-TIMEFRAME DATA (non-repainting)
// =====================================================================================================================
f_bias() =>
    float ef = ta.ema(close, emaFast)
    float es = ta.ema(close, emaSlow)
    close > es and ef > es ? 1 : close < es and ef < es ? -1 : 0

f_htfExpr() =>
    int b = f_bias()
    [b, b[1], high, high[1], low, low[1]]

// Returns the bias / high / low of the last CLOSED bar of timeframe `tf`.
// With lookahead_off, historical chart bars already receive only closed HTF bars. On the realtime bar the request
// returns the still-forming HTF bar, so the previous HTF bar is used unless the HTF bar closes together with this
// chart bar. Historical and realtime behaviour are therefore identical.
f_htf(simple string tf) =>
    [b0, b1, h0, h1, l0, l1] = request.security(syminfo.tickerid, tf, f_htfExpr(), barmerge.gaps_off, barmerge.lookahead_off)
    bool closesNow = time_close == time_close(tf)
    bool usePrev = barstate.isrealtime and not closesNow
    int bOut = usePrev ? b1 : b0
    float hOut = usePrev ? h1 : h0
    float lOut = usePrev ? l1 : l0
    [bOut, hOut, lOut]

[bias5, h5x, l5x] = f_htf("5")
[bias15, h15x, l15x] = f_htf("15")
[bias60, pHourHi, pHourLo] = f_htf("60")
[bias240, p4hHi, p4hLo] = f_htf("240")
[biasDx, pDayHi, pDayLo] = f_htf("D")

// =====================================================================================================================
// BAR CONTEXT
// =====================================================================================================================
float atrV = ta.atr(14)
float atrAvg = ta.sma(atrV, 200)
float atrRatio = atrV / atrAvg
float avgRange = ta.sma(high - low, 10)[1]

f_inSess(string sess, string tz) =>
    not na(time(timeframe.period, sess, tz))

bool inLdn = f_inSess(ldnSess, TZ_LDN)
bool inNy = f_inSess(nySess, TZ_NY)
int sessId = inNy ? 2 : inLdn ? 1 : 0
bool inKz = (inLdn and f_inSess(ldnKz, TZ_LDN)) or (inNy and f_inSess(nyKz, TZ_NY))
bool sessOk = sessId > 0 and (sessMode == "Both" or (sessMode == "London only" and sessId == 1) or (sessMode == "New York only" and sessId == 2))
bool inNews = newsOn and (f_inSess(news1, TZ_NY) or f_inSess(news2, TZ_NY))
string sessName = sessId == 1 ? "London" : sessId == 2 ? "New York" : "Off-session"

// Flatten window: from the configured New York time until the 18:00 re-open, measured on the bar CLOSE time.
int nyCloseMin = hour(time_close, TZ_NY) * 60 + minute(time_close, TZ_NY)
bool eodNow = nyCloseMin >= flatHour * 60 + flatMin and nyCloseMin < 18 * 60

// Liquidity sessions on the New York clock: Asia 18:00-03:00, London 03:00-08:00, New York 08:00-17:00.
int lsId = f_inSess("1800-0300", TZ_NY) ? 1 : f_inSess("0300-0800", TZ_NY) ? 2 : f_inSess("0800-1700", TZ_NY) ? 3 : 0
var int curLs = 0
var float lsHi = na
var float lsLo = na
float newSessHi = na
float newSessLo = na
if lsId != curLs
    if curLs != 0 and not na(lsHi)
        newSessHi := lsHi
        newSessLo := lsLo
    curLs := lsId
    lsHi := high
    lsLo := low
else
    lsHi := math.max(nz(lsHi, high), high)
    lsLo := math.min(nz(lsLo, low), low)

bool newDay = timeframe.change("D")

// Pivots (confirmed `len` bars after the pivot bar; no future data).
float phStruct = ta.pivothigh(high, structLen, structLen)
float plStruct = ta.pivotlow(low, structLen, structLen)
float phInt = ta.pivothigh(high, swingLen, swingLen)
float plInt = ta.pivotlow(low, swingLen, swingLen)
float phExt = ta.pivothigh(high, extLen, extLen)
float plExt = ta.pivotlow(low, extLen, extLen)

// Last opposing candle before the current bar (order block candidate).
f_lastOpp(bool bull) =>
    float lo = na
    float hi = na
    bool found = false
    for k = 1 to obLookback
        if not found
            bool opp = bull ? close[k] < open[k] : close[k] > open[k]
            if opp
                lo := low[k]
                hi := high[k]
                found := true
    [lo, hi]

[obBullLo, obBullHi] = f_lastOpp(true)
[obBearLo, obBearHi] = f_lastOpp(false)

// =====================================================================================================================
// PERSISTENT STATE
// =====================================================================================================================
var array<Liq> poolL = array.new<Liq>()
var array<Liq> poolS = array.new<Liq>()
var Setup stL = Setup.new()
var Setup stS = Setup.new()

