var int tHtf = 0
var int tKind = 0
var int tBars = 0
var float tLots = na
var float tRiskCash = na
var bool tBe = false
var bool tTrail = false
var bool tPart = false
var float tMfe = 0.0
var float tMae = 0.0
var float tReal = 0.0
var float tRem = 1.0
var bool vPend = false
var float accProfit = 0.0
var int lastEntryBar = -100000

// day / risk state
var int dayTrades = 0
var float dayPnl = 0.0
var int consecLoss = 0
var bool dayLossAlerted = false
var bool dayTradesAlerted = false

// adaptive engine state
var int adLevel = 0
var int adLastChange = 0
var int adIdleCnt = 0
var int closedN = 0
var int adDir = 0
var array<float> histR = array.new_float()
var array<int> histSess = array.new_int()
var array<int> histOb = array.new_int()
var array<int> histHtf = array.new_int()
var array<int> histKind = array.new_int()
var array<float> pen = array.new_float(8, 0.0)

// lifetime statistics
var int statWins = 0
var int statLosses = 0
var float statGp = 0.0
var float statGl = 0.0
var float statSumR = 0.0
var float statSumMfe = 0.0
var float statSumMae = 0.0
var int statMaxConsec = 0
var int statCurConsec = 0

// last signal (for the dashboard)
var int lastSigDir = 0
var float lastSigEntry = na
var float lastSigSl = na
var float lastSigTp = na
var float lastSigScore = na
var float lastSigRr = na

// drawings
var line lnEntry = na
var line lnSl = na
var line lnTp = na

// =====================================================================================================================
// CORE FUNCTIONS (direction-agnostic: shorts are processed on mirrored prices, i.e. price * -1)
// =====================================================================================================================
// Insert a liquidity level. Levels closer than `tol` are merged: two distinct swings become equal highs/lows.
f_addLevel(array<Liq> pool, float price, int kind, int born, float tol) =>
    bool merged = false
    int n = pool.size()
    if n > 0
        for q = 0 to n - 1
            Liq lv = pool.get(q)
            if not merged and math.abs(lv.price - price) <= tol
                if price == lv.price or kind > 3 or lv.kind > 3
                    if f_kindW(kind) > f_kindW(lv.kind)
                        lv.kind := kind
                else
                    lv.kind := 3
                if price < lv.price
                    lv.price := price
                merged := true
    if not merged
        if pool.size() >= MAX_POOL
            pool.shift()
        pool.push(Liq.new(price, kind, born, -1, price))
    merged

// Runs the liquidity -> sweep -> displacement -> MSS -> FVG -> retrace state machine for one direction.
// All prices are in mirrored space, so the logic below always reads as the BULLISH case.
// Returns true on the bar where the confirmation candle closes.
f_process(Setup st, array<Liq> pool, float hi, float lo, float op, float cl, float h2, float l1, float l2, float pivS, float pivI, float pivE, float s1h, float s4h, float sDay, float sSess, float obLoC, float obHiC, float dispMin, float fvgMin) =>
    bool signal = false
    float tol = eqTolAtr * atrV
    int newShBar = -1
    if not na(pivS)
        st.lastSH := pivS
        newShBar := bar_index - structLen

    // ---- age out old pools ----
    int q = pool.size() - 1
    while q >= 0
        Liq lvA = pool.get(q)
        int lim = lvA.kind >= 4 ? htfLiqMaxAge : liqMaxAge
        if bar_index - lvA.born > lim
            pool.remove(q)
        q -= 1

    // ---- register new pools ----
    if useInt and not na(pivI)
        f_addLevel(pool, pivI, 1, bar_index - swingLen, tol)
    if useExt and not na(pivE)
        f_addLevel(pool, pivE, 2, bar_index - extLen, tol)
    if use1h and not na(s1h) and (na(st.p1h) or s1h != st.p1h)
        if s1h < lo
            f_addLevel(pool, s1h, 4, bar_index, tol)
    st.p1h := s1h
    if use4h and not na(s4h) and (na(st.p4h) or s4h != st.p4h)
        if s4h < lo
            f_addLevel(pool, s4h, 5, bar_index, tol)
    st.p4h := s4h
    if useDay and not na(sDay) and (na(st.pDay) or sDay != st.pDay)
        if sDay < lo
            f_addLevel(pool, sDay, 7, bar_index, tol)
    st.pDay := sDay
    if useSessLiq and not na(sSess)
        if sSess < lo
            f_addLevel(pool, sSess, 6, bar_index, tol)

    // ---- sweeps: wick through a pool, candle close back above it ----
    float bestW = 0.0
    int bestKind = 0
    int cnt = 0
    float swExt = lo
    q := pool.size() - 1
    while q >= 0
        Liq lv = pool.get(q)
        if lv.born < bar_index
            bool swept = false
            bool broken = false
            if lv.pierceBar < 0
                if lo < lv.price
                    if cl > lv.price
                        swept := true
                        lv.pierceExt := lo
                    else
                        lv.pierceBar := bar_index
                        lv.pierceExt := lo
            else
                if lo < lv.pierceExt
                    lv.pierceExt := lo
                if cl > lv.price and bar_index - lv.pierceBar <= reclaimBars
                    swept := true
                else if bar_index - lv.pierceBar >= reclaimBars
                    broken := true
            if swept
                float wq = f_kindW(lv.kind)
                cnt += 1
                if wq > bestW
                    bestW := wq
                    bestKind := lv.kind
                if lv.pierceExt < swExt
                    swExt := lv.pierceExt
            if swept or broken
                pool.remove(q)
        q -= 1

    if cnt > 0 and bestW >= minLiqW and st.stage <= 1
        if not na(st.lastSH) and st.lastSH > cl
            float gw = math.min(1.0, bestW + 0.1 * (cnt - 1))
            float rejn = f_clamp((cl - swExt) / atrV, 0.0, 1.0)
            if st.stage == 1 and st.ext < swExt
                swExt := st.ext
            st.stage := 1
            st.sweepBar := bar_index
            st.ext := swExt
            st.sweepQ := 0.6 * gw + 0.4 * rejn
            st.sweepKind := bestKind
            st.mssLvl := st.lastSH
            st.dispStr := 0.0
            st.fvgBar := -1
            st.touched := false
            st.obLo := na
            st.obHi := na

    // ---- setup state machine ----
    bool gapNow = lo > h2 and lo - h2 >= fvgMin * atrV
    if st.stage == 1
        if lo < st.ext
            st.ext := lo
        // a structure high that formed before the sweep but confirmed after it is the better MSS reference
        if newShBar >= 0 and newShBar < st.sweepBar and pivS < st.mssLvl and pivS > cl
            st.mssLvl := pivS
        float body = cl - op
        float rng = hi - lo
        if body > 0 and rng > 0 and not na(avgRange)
            if body >= dispMin * atrV and body / rng >= dispBodyRatio and rng >= dispExpMult * avgRange and (hi - cl) / rng <= dispClosePos
                float strength = body / atrV
                if strength > st.dispStr
                    if st.dispStr == 0.0
                        st.obLo := obLoC
                        st.obHi := obHiC
                    st.dispStr := strength
        if bar_index - 1 >= st.sweepBar and gapNow
            st.fvgTop := lo
            st.fvgBot := h2
            st.fvgBar := bar_index
            st.fvgSz := (lo - h2) / atrV
            st.fvgOrg := math.min(l1, l2)
        if cl > st.mssLvl and st.dispStr > 0.0
            st.stage := 2
            st.mssBar := bar_index
            st.mssMargin := (cl - st.mssLvl) / atrV
        else if bar_index - st.sweepBar > setupMaxBars
            st.stage := 0
    else if st.stage == 2
        if not st.touched and bar_index <= st.mssBar + fvgWait and gapNow
            st.fvgTop := lo
            st.fvgBot := h2
            st.fvgBar := bar_index
            st.fvgSz := (lo - h2) / atrV
            st.fvgOrg := math.min(l1, l2)
        if st.fvgBar < 0
            if bar_index >= st.mssBar + fvgWait
                st.stage := 0
        else if bar_index > st.fvgBar
            bool dead = false
            if lo < st.ext
                dead := true
            else if mitigMode == "Close through gap" and cl < st.fvgBot
                dead := true
            else if mitigMode == "Wick through gap" and lo < st.fvgBot
                dead := true
            else if bar_index - st.fvgBar > fvgMaxAge
                dead := true
            if dead
                st.stage := 0
            else
                if lo <= st.fvgTop - fvgDepth * (st.fvgTop - st.fvgBot)
                    st.touched := true
                float mid = 0.5 * (st.fvgTop + st.fvgBot)
                if st.touched and cl > op and (not confirmMid or cl > mid)
                    signal := true
                    st.stage := 0
    signal

// Scores a confirmed setup and applies every entry filter. Mirrored space.
// Returns [rejectCode (-1 = accepted), score, stopM, risk, targetM, alignedTFs, hasOB, requiredScore].
f_eval(Setup st, int dir, float cl, array<Liq> oppPool, float minScoreEff, int htfReqEff, int nHtf, float rrV, bool posBusy) =>
    float bufMult = volAdjBuf ? math.max(1.0, nz(atrRatio, 1.0)) : 1.0
    float anchor = slAnchor == "Sweep extreme" ? st.ext : st.fvgOrg
    float slM = anchor - slBufAtr * atrV * bufMult - (dir < 0 and padShortSl ? spreadUsd : 0.0)
    float risk = cl - slM
    float stopAtr = risk / atrV
    int hasOb = 0
    if not na(st.obHi)
        if st.obHi >= st.fvgBot - 0.25 * atrV and st.obLo <= st.fvgTop
            hasOb := 1
    int hc = 0
    bool opp1 = false
    bool opp4 = false
    if use5m and bias5 == dir
        hc += 1
    if use15m and bias15 == dir
        hc += 1
    if use60m
        if bias60 == dir
            hc += 1
        else if bias60 == -dir
            opp1 := true
    if use240m
        if bias240 == dir
            hc += 1
        else if bias240 == -dir
            opp4 := true
    float scDisp = 0.5 + 0.5 * f_clamp(st.dispStr - dispMinAtr, 0.0, 1.0)
    float scMss = 0.6 + 0.4 * f_clamp(st.mssMargin / 0.5, 0.0, 1.0)
    float scFvg = 0.5 + 0.5 * f_clamp((st.fvgSz - fvgMinAtr) / 0.5, 0.0, 1.0)
    float scHtf = nHtf > 0 ? hc / (nHtf * 1.0) : 0.0
    float scSess = sessId > 0 and inKz ? 1.0 : sessId > 0 ? 0.6 : 0.0
    float score = wSweep * st.sweepQ + wDisp * scDisp + wMss * scMss + wFvg * scFvg + wHtf * scHtf + wOb * hasOb + wSess * scSess

    // nearest opposing liquidity pool (grade >= 0.5) beyond the entry
    float near = na
    int n = oppPool.size()
    if n > 0
        for q = 0 to n - 1
            Liq lv = oppPool.get(q)
            if f_kindW(lv.kind) >= 0.5
                float lvlM = -lv.price
                if lvlM > cl and (na(near) or lvlM < near)
                    near := lvlM
    float tpM = cl + rrV * risk
    if tpMode == "Opposing liquidity (dynamic)" and not na(near)
        float tgtR = (near - cl) / risk
        if tgtR >= minTargetR
            tpM := cl + math.min(tgtR, maxTargetR) * risk

    // adaptive condition penalties
    float need = minScoreEff
    if adOn and sessId > 0
        need += pen.get(sessId - 1) + pen.get(2 + hasOb) + pen.get(4 + (hc >= 3 ? 1 : 0)) + pen.get(6 + (st.sweepKind >= 4 ? 1 : 0))

    bool vetoHit = (htfVeto != "None" and opp1) or (htfVeto == "1H and 4H must not oppose" and opp4)
    int rej = -1
    if not sessOk
        rej := 0
    else if eodNow
        rej := 14
    else if inNews
        rej := 16
    else if volFilter and (na(atrRatio) or atrRatio < volMin or atrRatio > volMax)
        rej := 11
    else if stopAtr < minStopAtr or (minStopUsd > 0 and risk < minStopUsd)
        rej := 3
    else if stopAtr > maxStopAtr or (maxStopUsd > 0 and risk > maxStopUsd)
        rej := 4
    else if hc < htfReqEff or vetoHit
        rej := 1
    else if obRequired and hasOb == 0
        rej := 13
    else if minRoomR > 0 and not na(near) and near - cl < minRoomR * risk
        rej := 5
    else if score < need
        rej := 2
    else if dayTrades >= maxTradesDay
        rej := 6
    else if dayPnl <= -maxDailyLoss
        rej := 7
    else if dailyProfitLock > 0 and dayPnl >= dailyProfitLock
        rej := 15
    else if maxConsecLoss > 0 and consecLoss >= maxConsecLoss
        rej := 8
    else if bar_index - lastEntryBar < cooldownBars
        rej := 9
    else if posBusy
        rej := 10
    [rej, score, slM, risk, tpM, hc, hasOb, need]

// Rolling statistics over the last `n` completed trades: [count, win rate %, profit factor, expectancy R].
f_roll(int n) =>
    int sz = histR.size()
    int m = math.min(n, sz)
    float gp = 0.0
    float gl = 0.0
    float sum = 0.0
    int w = 0
    if m > 0
        for k = 0 to m - 1
            float r = histR.get(sz - 1 - k)
            sum += r
            if r > 0
                w += 1
                gp += r
            else
                gl -= r
    float wr = m > 0 ? 100.0 * w / m : na
    float pf = gl > 0 ? gp / gl : na
    float ex = m > 0 ? sum / m : na
    [m, wr, pf, ex]

// Expectancy of one condition bucket over the stored history: returns the score penalty to apply.
f_bucketPen(array<int> feat, int v) =>
    int c = 0
    float s = 0.0
    int sz = histR.size()
    if sz > 0
        for k = 0 to sz - 1
            if feat.get(k) == v
                c += 1
                s += histR.get(k)
    c >= adBucketN and s / math.max(c, 1) < adBucketExp ? adBucketPen : 0.0

f_lots(float riskDist, float equity) =>
    float riskCash = equity * riskPct / 100.0
    float rawOz = riskCash / (riskDist * syminfo.pointvalue)
    float lots = math.floor(rawOz / contractSize / lotStep + 1e-9) * lotStep
    lots := math.min(lots, maxLots)
    lots

// =====================================================================================================================
// DAILY RESET
// =====================================================================================================================
bool evAdaptChanged = false
if newDay
    dayTrades := 0
    dayPnl := 0.0
    consecLoss := 0
    dayLossAlerted := false
    dayTradesAlerted := false
    // Idle decay: without it, tightened filters could block the very trades needed to relax them again.
    adIdleCnt += 1
    if adOn and adLevel > 0 and adIdleDays > 0 and adIdleCnt >= adIdleDays
        adLevel -= 1
        adIdleCnt := 0
        adLastChange := closedN
        adDir := -1
        evAdaptChanged := true

// =====================================================================================================================
// TRADE TRACKING: detect fills and exits of the open trade
// =====================================================================================================================
bool evClosed = false
float evR = na
float evMfe = na
float evMae = na
string evReason = ""
float evExitPx = na
bool evEntry = false

// The indicator simulates each signal as a virtual trade: entry at the next bar's open, spread charged on the ask
// side, and if stop and target are both inside one bar the STOP is assumed to be hit first (conservative).
float xo = tDir > 0 ? open : -(open + spreadUsd)
float xh = tDir > 0 ? high : -(low + spreadUsd)
float xl = tDir > 0 ? low : -(high + spreadUsd)
if vPend
    vPend := false
    float eM = tDir > 0 ? open + spreadUsd : -open
    float slM0 = tDir * tSl
    float tpM0 = tDir * tTp
    if eM > slM0 and eM < tpM0
        tOpen := true
        tEntry := tDir * eM
        evEntry := true
    else
        tDir := 0
if tOpen
    float eM = tDir * tEntry
    float slM = tDir * tSl
    float tpM = tDir * tTp
    bool done = false
    float xp = na
    if not evEntry and (eodNow[1] or (maxHoldBars > 0 and tBars >= maxHoldBars))
        done := true
        xp := xo
        evReason := "EOD"
    else if xo <= slM
        done := true
        xp := xo
        evReason := "SL"
    else if xl <= slM
        done := true
        xp := slM
        evReason := "SL"
    else if xh >= tpM
        done := true
        xp := tpM
        evReason := "TP"
    if done
        if evReason == "SL" and tTrail
            evReason := "TRAIL"
        else if evReason == "SL" and tBe
            evReason := "BE"
        if evReason == "TP"
            tMfe := math.max(tMfe, (tpM - eM) / tRisk)
        else
            tMae := math.max(tMae, (eM - xp) / tRisk)
        evClosed := true
        evR := (tReal + tRem * (xp - eM)) / tRisk
        evMfe := tMfe
        evMae := tMae
        evExitPx := tDir * xp
    else
        if partOn and not tPart and xh >= eM + partR * tRisk
            tPart := true
            tReal += partPct / 100.0 * partR * tRisk
            tRem := 1.0 - partPct / 100.0
        tMfe := math.max(tMfe, (xh - eM) / tRisk)
        tMae := math.max(tMae, (eM - xl) / tRisk)

// ---- stop management at bar close (takes effect from the next bar; stops only ever move in the trade's favour) ----
if tOpen and not evClosed and not na(tEntry)
    tBars += 1
    float eMm = tDir * tEntry
    float hiM = tDir > 0 ? high : -low
    float slMm = tDir * tSl
    if beOn and not tBe and hiM >= eMm + beR * tRisk
        tBe := true
        slMm := math.max(slMm, eMm + beOffR * tRisk)
    if trailOn and tMfe >= trailStartR
        float ns = hiM - trailAtr * atrV
        if ns > slMm
            slMm := ns
            tTrail := true
    tSl := tDir * slMm

// =====================================================================================================================
// COMPLETED TRADE: statistics and adaptive engine
// =====================================================================================================================
bool evSlHit = false
bool evTpHit = false
if evClosed
    closedN += 1
    adIdleCnt := 0
    dayPnl += riskPct * evR
    statSumR += evR
    statSumMfe += nz(evMfe)
    statSumMae += nz(evMae)
    if evR > 0
        statWins += 1
        statGp += evR
    else
        statLosses += 1
        statGl -= evR
    if evR < -0.05
        consecLoss += 1
        statCurConsec += 1
        statMaxConsec := math.max(statMaxConsec, statCurConsec)
    else if evR > 0.05
        consecLoss := 0
        statCurConsec := 0
    evSlHit := evReason == "SL"
    evTpHit := evReason == "TP"

    histR.push(evR)
    histSess.push(tSess - 1)
    histOb.push(tOb)
    histHtf.push(tHtf >= 3 ? 1 : 0)
    histKind.push(tKind >= 4 ? 1 : 0)
    if histR.size() > 50
        histR.shift()
        histSess.shift()
        histOb.shift()
        histHtf.shift()
        histKind.shift()

    if adOn and closedN >= adMinSample
        [mW, wrW, pfW, exW] = f_roll(adWindow)
        if closedN - adLastChange >= adCooldown
            int newLevel = adLevel
            if exW < adTightenExp and adLevel < adMaxLevel
                newLevel := adLevel + 1
            else if exW > adRelaxExp and adLevel > 0
                newLevel := adLevel - 1
            if newLevel != adLevel
                adDir := newLevel > adLevel ? 1 : -1
                adLevel := newLevel
                adLastChange := closedN
                evAdaptChanged := true
        pen.set(0, f_bucketPen(histSess, 0))
        pen.set(1, f_bucketPen(histSess, 1))
        pen.set(2, f_bucketPen(histOb, 0))
        pen.set(3, f_bucketPen(histOb, 1))
        pen.set(4, f_bucketPen(histHtf, 0))
        pen.set(5, f_bucketPen(histHtf, 1))
        pen.set(6, f_bucketPen(histKind, 0))
        pen.set(7, f_bucketPen(histKind, 1))

    if showExits
        bool win = evR > 0
        label.new(bar_index, tDir > 0 ? high : low, evReason + " " + str.tostring(evR, "#.##") + "R", style=tDir > 0 ? label.style_label_down : label.style_label_up, color=color.new(win ? color.green : color.red, 70), textcolor=win ? color.green : color.red, size=size.tiny)
    tOpen := false
    tDir := 0
    accProfit := 0.0

// =====================================================================================================================
// EFFECTIVE (ADAPTIVE) THRESHOLDS - never below the configured baseline
// =====================================================================================================================
int nHtf = (use5m ? 1 : 0) + (use15m ? 1 : 0) + (use60m ? 1 : 0) + (use240m ? 1 : 0)
float dispMinEff = dispMinAtr + adLevel * adStepDisp
float fvgMinEff = fvgMinAtr + adLevel * adStepFvg
float minScoreEff = minScoreBase + adLevel * adStepScore
int htfReqEff = math.min(nHtf, htfReq + (adLevel >= 2 ? 1 : 0))
float rrV = rrSel == "1:1" ? 1.0 : rrSel == "1:1.5" ? 1.5 : rrSel == "1:2" ? 2.0 : rrSel == "1:3" ? 3.0 : rrSel == "1:4" ? 4.0 : rrCustom

// =====================================================================================================================
// SETUP ENGINE (both directions)
// =====================================================================================================================
bool ready = not na(atrV) and atrV > 0 and bar_index > 260
bool sigL = false
bool sigS = false
if ready
    sigL := f_process(stL, poolL, high, low, open, close, high[2], low[1], low[2], phStruct, plInt, plExt, pHourLo, p4hLo, pDayLo, newSessLo, obBullLo, obBullHi, dispMinEff, fvgMinEff)
    sigS := f_process(stS, poolS, -low, -high, -open, -close, -low[2], -high[1], -high[2], -plStruct, -phInt, -phExt, -pHourHi, -p4hHi, -pDayHi, -newSessHi, -obBearHi, -obBearLo, dispMinEff, fvgMinEff)

// =====================================================================================================================
// SIGNAL EVALUATION AND ENTRY
// =====================================================================================================================
bool posBusy = tOpen or vPend
bool buySignal = false
bool sellSignal = false
int rejL = -2
int rejS = -2
float scL = na
float scS = na
float slL = na
float slS = na
float rkL = na
float rkS = na
float tpL = na
float tpS = na
int hcL = 0
int hcS = 0
int obL = 0
int obS = 0
float needL = na
float needS = na
if sigL
    [r0, s0, a0, b0, c0, d0, e0, f0] = f_eval(stL, 1, close, poolS, minScoreEff, htfReqEff, nHtf, rrV, posBusy)
    rejL := r0
    scL := s0
    slL := a0
    rkL := b0
    tpL := c0
    hcL := d0
    obL := e0
    needL := f0
if sigS
    [r1, s1, a1, b1, c1, d1, e1, f1] = f_eval(stS, -1, -close, poolL, minScoreEff, htfReqEff, nHtf, rrV, posBusy)
    rejS := r1
    scS := s1
    slS := -a1
    rkS := b1
    tpS := -c1
    hcS := d1
    obS := e1
    needS := f1

float eqNow = acctEquity
int goDir = rejL == -1 ? 1 : rejS == -1 ? -1 : 0
float goSl = goDir == 1 ? slL : slS
float goTp = goDir == 1 ? tpL : tpS
float goRisk = goDir == 1 ? rkL : rkS
float goScore = goDir == 1 ? scL : scS
float goLots = goDir != 0 ? f_lots(goRisk, eqNow) : na
bool sizeOk = goDir != 0 and goLots >= minLot
bool evSizeReject = goDir != 0 and not sizeOk
string alertMsg = ""

if goDir != 0 and sizeOk and barstate.isconfirmed
    buySignal := goDir == 1
    sellSignal := goDir == -1
    float qtyUnits = goLots * contractSize
    vPend := true
    tDir := goDir
    tOpen := false
    tEntry := na
    tSl := goSl
    tSlInit := goSl
    tTp := goTp
    tRisk := goRisk
    tScore := goScore
    tSess := sessId
    tOb := goDir == 1 ? obL : obS
    tHtf := goDir == 1 ? hcL : hcS
    tKind := goDir == 1 ? stL.sweepKind : stS.sweepKind
    tBars := 0
    tLots := goLots
    tRiskCash := qtyUnits * goRisk * syminfo.pointvalue
    tBe := false
    tTrail := false
    tPart := false
    tMfe := 0.0
    tMae := 0.0
    tReal := 0.0
    tRem := 1.0
    accProfit := 0.0
    dayTrades += 1
    lastEntryBar := bar_index
    lastSigDir := goDir
    lastSigEntry := close
    lastSigSl := goSl
    lastSigTp := goTp
    lastSigScore := goScore
    lastSigRr := math.abs(goTp - close) / goRisk

    alertMsg := '{"event":"' + (goDir == 1 ? "BUY" : "SELL") + '","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","direction":"' + (goDir == 1 ? "long" : "short") + '","entry":' + str.tostring(close, format.mintick) + ',"stop_loss":' + str.tostring(goSl, format.mintick) + ',"take_profit":' + str.tostring(goTp, format.mintick) + ',"risk_reward":' + str.tostring(lastSigRr, "#.##") + ',"score":' + str.tostring(goScore, "#.#") + ',"session":"' + sessName + '","lots":' + str.tostring(goLots, "#.##") + ',"liquidity":"' + f_kindName(tKind) + '","adaptive_level":' + str.tostring(adLevel) + ',"time":' + str.tostring(time_close) + '}'

    if showSignals
        label.new(bar_index, goDir == 1 ? low : high, (goDir == 1 ? "BUY " : "SELL ") + str.tostring(goScore, "#"), style=goDir == 1 ? label.style_label_up : label.style_label_down, color=goDir == 1 ? C_BUY : C_SELL, textcolor=color.white, size=size.small, tooltip="Entry ~" + str.tostring(close, format.mintick) + "\nSL " + str.tostring(goSl, format.mintick) + "\nTP " + str.tostring(goTp, format.mintick) + "\nRR 1:" + str.tostring(lastSigRr, "#.##") + "\nScore " + str.tostring(goScore, "#.#") + " / required " + str.tostring(goDir == 1 ? needL : needS, "#.#") + "\nLiquidity: " + f_kindName(tKind) + "\nLots " + str.tostring(goLots, "#.##"))
    if showFvg
        Setup sx = goDir == 1 ? stL : stS
        box.new(sx.fvgBar - 2, math.max(goDir * sx.fvgTop, goDir * sx.fvgBot), bar_index, math.min(goDir * sx.fvgTop, goDir * sx.fvgBot), border_color=color.new(goDir == 1 ? color.green : color.red, 60), bgcolor=color.new(goDir == 1 ? color.green : color.red, 85))
    if showLevels
        lnEntry := line.new(bar_index, close, bar_index + 1, close, color=C_NEUT, style=line.style_dotted)
        lnSl := line.new(bar_index, goSl, bar_index + 1, goSl, color=C_SELL)
        lnTp := line.new(bar_index, goTp, bar_index + 1, goTp, color=C_BUY)


// extend the level lines while the trade is alive
if showLevels and (tOpen or vPend) and not na(lnEntry)
    line.set_x2(lnEntry, bar_index + 1)
    line.set_x2(lnSl, bar_index + 1)
    line.set_x2(lnTp, bar_index + 1)
    line.set_y1(lnSl, tSl)
    line.set_y2(lnSl, tSl)

// =====================================================================================================================
// LIMIT EVENTS
// =====================================================================================================================
bool evDayLoss = false
bool evDayTrades = false
if dayPnl <= -maxDailyLoss and not dayLossAlerted
    dayLossAlerted := true
    evDayLoss := true
if dayTrades >= maxTradesDay and not dayTradesAlerted
    dayTradesAlerted := true
    evDayTrades := true

// =====================================================================================================================
// PLOTS
// =====================================================================================================================
plot(showDayLv ? pDayHi : na, "Previous day high", color=color.new(color.gray, 40), style=plot.style_stepline)
plot(showDayLv ? pDayLo : na, "Previous day low", color=color.new(color.gray, 40), style=plot.style_stepline)
bgcolor(sessId == 1 ? color.new(color.blue, 95) : sessId == 2 ? color.new(color.orange, 95) : na, title="Session background")

// =====================================================================================================================
// DASHBOARD
// =====================================================================================================================
f_biasTxt(int b) =>
    b > 0 ? "▲" : b < 0 ? "▼" : "•"

f_row(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color=color.silver, text_halign=text.align_left, text_size=size.small, bgcolor=color.new(color.black, 20))
    table.cell(t, 1, r, v, text_color=c, text_halign=text.align_right, text_size=size.small, bgcolor=color.new(color.black, 20))

int biasSum = (use5m ? bias5 : 0) + (use15m ? bias15 : 0) + (use60m ? bias60 : 0) + (use240m ? bias240 : 0)
string biasName = biasSum >= 2 ? "BULLISH" : biasSum <= -2 ? "BEARISH" : "NEUTRAL"
color biasCol = biasSum >= 2 ? C_BUY : biasSum <= -2 ? C_SELL : C_NEUT

var table dash = na
if showDash and barstate.islast
    if na(dash)
        string pos = dashPos == "Top right" ? position.top_right : dashPos == "Bottom right" ? position.bottom_right : dashPos == "Top left" ? position.top_left : position.bottom_left
        dash := table.new(pos, 2, 20, border_width=1, border_color=color.new(color.gray, 70), frame_width=1, frame_color=color.new(color.gray, 50))
    [m20, wr20, pf20, ex20] = f_roll(adWindow)
    [m50, wr50, pf50, ex50] = f_roll(50)
    string adMode = not adOn ? "OFF" : closedN < adMinSample ? "LEARNING (" + str.tostring(closedN) + "/" + str.tostring(adMinSample) + ")" : adLevel == 0 ? "BASELINE" : "TIGHTENED L" + str.tostring(adLevel)
    string adMove = adDir > 0 ? "tightened" : adDir < 0 ? "relaxed" : "unchanged"
    string posTxt = vPend ? "PENDING " + (tDir == 1 ? "LONG" : "SHORT") : tOpen ? (tDir == 1 ? "LONG" : "SHORT") + (tBe ? " (BE)" : "") : "FLAT"
    color posCol = tDir == 1 ? C_BUY : tDir == -1 ? C_SELL : C_NEUT
    string sigTxt = lastSigDir == 1 ? "BUY" : lastSigDir == -1 ? "SELL" : "-"
    color sigCol = lastSigDir == 1 ? C_BUY : lastSigDir == -1 ? C_SELL : C_NEUT
    int r = 0
    table.cell(dash, 0, r, "ICT Adaptive Scalper", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 0), text_halign=text.align_left)
    table.cell(dash, 1, r, syminfo.ticker + " " + timeframe.period, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 0), text_halign=text.align_right)
    r += 1
    f_row(dash, r, "Bias 4H 1H 15M 5M", f_biasTxt(bias240) + " " + f_biasTxt(bias60) + " " + f_biasTxt(bias15) + " " + f_biasTxt(bias5) + "  " + biasName, biasCol)
    r += 1
    f_row(dash, r, "Session", sessName + (inKz ? " (kill zone)" : ""), sessId > 0 ? color.white : C_NEUT)
    r += 1
    f_row(dash, r, "Last signal", sigTxt + (na(lastSigScore) ? "" : "  score " + str.tostring(lastSigScore, "#")), sigCol)
    r += 1
    if not dashCompact
        f_row(dash, r, "Entry", str.tostring(lastSigEntry, format.mintick), color.white)
        r += 1
        f_row(dash, r, "Stop loss", str.tostring(lastSigSl, format.mintick), C_SELL)
        r += 1
        f_row(dash, r, "Take profit", str.tostring(lastSigTp, format.mintick), C_BUY)
        r += 1
        f_row(dash, r, "Risk / reward", na(lastSigRr) ? "-" : "1:" + str.tostring(lastSigRr, "#.##"), color.white)
        r += 1
        f_row(dash, r, "Stop distance", na(lastSigSl) ? "-" : "$" + str.tostring(math.abs(lastSigEntry - lastSigSl), "#.##") + " / " + str.tostring(math.abs(lastSigEntry - lastSigSl) / atrV, "#.#") + " ATR", color.white)
        r += 1
    f_row(dash, r, "Position", posTxt, posCol)
    r += 1
    f_row(dash, r, "Trades today", str.tostring(dayTrades) + " / " + str.tostring(maxTradesDay), dayTrades >= maxTradesDay ? C_SELL : color.white)
    r += 1
    f_row(dash, r, "Day realized P/L", str.tostring(dayPnl, "#.##") + "%", dayPnl > 0 ? C_BUY : dayPnl < 0 ? C_SELL : C_NEUT)
    r += 1
    f_row(dash, r, "Win rate (last " + str.tostring(m20) + ")", na(wr20) ? "-" : str.tostring(wr20, "#.#") + "%", color.white)
    r += 1
    f_row(dash, r, "Profit factor (last " + str.tostring(m20) + ")", na(pf20) ? "-" : str.tostring(pf20, "#.##"), color.white)
    r += 1
    f_row(dash, r, "Expectancy (last " + str.tostring(m20) + ")", na(ex20) ? "-" : str.tostring(ex20, "#.##") + " R", nz(ex20) > 0 ? C_BUY : nz(ex20) < 0 ? C_SELL : C_NEUT)
    r += 1
    if not dashCompact
        f_row(dash, r, "WR / PF (last " + str.tostring(m50) + ")", na(wr50) ? "-" : str.tostring(wr50, "#.#") + "% / " + (na(pf50) ? "-" : str.tostring(pf50, "#.##")), color.white)
        r += 1
        f_row(dash, r, "Avg MFE / MAE", closedN > 0 ? str.tostring(statSumMfe / closedN, "#.##") + " R / " + str.tostring(statSumMae / closedN, "#.##") + " R" : "-", color.white)
        r += 1
    f_row(dash, r, "Adaptive mode", adMode, adLevel > 0 ? color.orange : color.white)
    r += 1
    f_row(dash, r, "Min score now", str.tostring(minScoreEff, "#.#") + " (base " + str.tostring(minScoreBase, "#") + ", " + adMove + ")", color.white)
    r += 1
    f_row(dash, r, "Trades analysed", str.tostring(closedN) + "  max losing run " + str.tostring(statMaxConsec), color.white)

// =====================================================================================================================
// ALERTS (confirmed bars only; each event can fire at most once per bar)
// =====================================================================================================================
if dynAlerts and barstate.isconfirmed
    if buySignal or sellSignal
        alert(alertMsg, alert.freq_once_per_bar_close)
    if evEntry
        alert('{"event":"ENTRY_FILLED","symbol":"' + syminfo.ticker + '","direction":"' + (tDir == 1 ? "long" : "short") + '","entry":' + str.tostring(tEntry, format.mintick) + '}', alert.freq_once_per_bar_close)
    if evClosed
        alert('{"event":"EXIT","symbol":"' + syminfo.ticker + '","reason":"' + evReason + '","result_r":' + str.tostring(evR, "#.##") + ',"exit":' + str.tostring(evExitPx, format.mintick) + ',"time":' + str.tostring(time_close) + '}', alert.freq_once_per_bar_close)
    if evDayLoss
        alert('{"event":"DAILY_LOSS_LIMIT","symbol":"' + syminfo.ticker + '","day_pnl_pct":' + str.tostring(dayPnl, "#.##") + '}', alert.freq_once_per_bar_close)
    if evDayTrades
        alert('{"event":"MAX_DAILY_TRADES","symbol":"' + syminfo.ticker + '","trades":' + str.tostring(dayTrades) + '}', alert.freq_once_per_bar_close)
    if evAdaptChanged
        alert('{"event":"ADAPTIVE_CHANGED","symbol":"' + syminfo.ticker + '","level":' + str.tostring(adLevel) + ',"min_score":' + str.tostring(minScoreEff, "#.#") + ',"direction":"' + (adDir > 0 ? "tightened" : "relaxed") + '"}', alert.freq_once_per_bar_close)

alertcondition(buySignal, "BUY signal", "ICT-AS BUY {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSignal, "SELL signal", "ICT-AS SELL {{ticker}} {{interval}} @ {{close}}")
alertcondition(evEntry, "Trade entry", "ICT-AS trade entered {{ticker}} {{interval}}")
alertcondition(evSlHit, "Stop loss hit", "ICT-AS stop loss hit {{ticker}}")
alertcondition(evTpHit, "Take profit hit", "ICT-AS take profit hit {{ticker}}")
alertcondition(evDayLoss, "Daily loss limit reached", "ICT-AS daily loss limit reached {{ticker}}")
alertcondition(evDayTrades, "Maximum daily trades reached", "ICT-AS maximum daily trades reached {{ticker}}")
alertcondition(evAdaptChanged, "Adaptive filter changed", "ICT-AS adaptive filter changed {{ticker}}")
plotshape(buySignal, "BUY marker", shape.triangleup, location.belowbar, C_BUY, size=size.tiny, display=display.data_window)
plotshape(sellSignal, "SELL marker", shape.triangledown, location.abovebar, C_SELL, size=size.tiny, display=display.data_window)
