// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// XAUUSD ICT Adaptive Scalping System
// Sequence: liquidity sweep -> displacement -> market structure shift -> fair value gap -> retrace -> confirmation.
// Everything is evaluated on confirmed bar closes; higher-timeframe data is requested with lookahead_off and only
// the last CLOSED higher-timeframe bar is used, so signals never repaint.
// The "adaptive engine" is a deterministic, rule-based filter controller. It is not machine learning and it keeps
// no memory between chart reloads: its state is recalculated from the bars loaded on the chart.
//@version=6
indicator("XAUUSD ICT Adaptive Scalper [Indicator]", shorttitle="ICT-AS", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

// =====================================================================================================================
// INPUTS
// =====================================================================================================================
string G_LIQ = "1 - Liquidity"
int swingLen = input.int(5, "Internal swing length", minval=2, maxval=30, group=G_LIQ, tooltip="Pivot length for internal liquidity (short-term swing highs/lows).")
int extLen = input.int(20, "External swing length", minval=5, maxval=60, group=G_LIQ, tooltip="Pivot length for external liquidity (major swing highs/lows).")
float eqTolAtr = input.float(0.10, "Equal high/low tolerance (ATR)", minval=0.0, step=0.01, group=G_LIQ)
int liqMaxAge = input.int(300, "Swing pool max age (bars)", minval=20, group=G_LIQ)
int htfLiqMaxAge = input.int(1500, "HTF/session/day pool max age (bars)", minval=50, group=G_LIQ)
float minLiqW = input.float(0.35, "Minimum liquidity grade", minval=0.0, maxval=1.0, step=0.05, group=G_LIQ, tooltip="Grades: internal swing 0.35, prev 1H 0.55, external swing 0.65, equal H/L 0.80, prev 4H 0.80, prev session 0.90, prev day 1.00. Raise to ignore minor pools.")
int reclaimBars = input.int(2, "Bars allowed to reclaim a pierced level", minval=0, maxval=5, group=G_LIQ, tooltip="0 = the sweep candle itself must close back across the level.")
bool useInt = input.bool(true, "Internal swings", group=G_LIQ, inline="liq1")
bool useExt = input.bool(true, "External swings", group=G_LIQ, inline="liq1")
bool use1h = input.bool(true, "Prev 1H", group=G_LIQ, inline="liq2")
bool use4h = input.bool(true, "Prev 4H", group=G_LIQ, inline="liq2")
