// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © alikamal94
//
// ORB NY — New York Opening Range Breakout + Retest
//  1) Builds the NY opening range on the 1, 5 and 15 minute windows (09:30 ET by default).
//  2) Watches for a breakout of the ORB High, ORB Low or the 50% level (candle CLOSE beyond the level).
//  3) Confirms the entry on the retest with a Fair Value Gap, a level (High/Low) retest, or a strong rejection candle.
//
// Non-repainting rules used in this version:
//  - Every signal, label and line is created only on a CONFIRMED (closed) candle.
//  - All drawings use xloc.bar_time with fixed end points, so nothing is ever moved after it is drawn.
//  - Drawings are stored per session in var arrays; only whole old sessions are deleted (Days to keep).
//  - One breakout label per level/direction per session, and no new setups once the daily signal limit is reached.
//
// Chart timeframe note: an ORB window can only be built when the chart timeframe fits inside it.
//  1m chart  -> 1m, 5m and 15m ORB
//  5m chart  -> 5m and 15m ORB
//  15m chart -> 15m ORB

//@version=6
indicator("ORB NY — Opening Range Breakout + Retest", "ORB NY", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
const string G_SES = "New York session"
tz          = input.string("America/New_York", "Timezone", group = G_SES)
openH       = input.int(9,  "Open hour",   0, 23, group = G_SES, inline = "o")
openM       = input.int(30, "minute",      0, 59, group = G_SES, inline = "o")
sigEndH     = input.int(12, "Stop new signals at hour", 0, 23, group = G_SES, inline = "s")
sigEndM     = input.int(0,  "minute",      0, 59, group = G_SES, inline = "s")
lvlEndH     = input.int(16, "Levels / trades end hour", 0, 23, group = G_SES, inline = "l")
lvlEndM     = input.int(0,  "minute",      0, 59, group = G_SES, inline = "l")
keepDays    = input.int(10, "Days of drawings to keep", minval = 1, maxval = 60, group = G_SES)

const string G_ORB = "Opening ranges"
show1       = input.bool(true, "1m ORB",  group = G_ORB, inline = "1")
col1        = input.color(color.new(#FFB300, 0), "", group = G_ORB, inline = "1")
show5       = input.bool(true, "5m ORB",  group = G_ORB, inline = "5")
col5        = input.color(color.new(#2196F3, 0), "", group = G_ORB, inline = "5")
show15      = input.bool(true, "15m ORB", group = G_ORB, inline = "15")
col15       = input.color(color.new(#AB47BC, 0), "", group = G_ORB, inline = "15")
showMid     = input.bool(true, "Show 50% level", group = G_ORB)
showBox     = input.bool(true, "Shade range box", group = G_ORB)
signalTF    = input.string("Auto", "ORB used for signals", options = ["Auto", "1", "5", "15"], group = G_ORB,
               tooltip = "Auto = same as the chart timeframe when it is 1/5/15 minutes, otherwise the 15m ORB.")

const string G_BRK = "Breakout"
useHL       = input.bool(true, "Trade ORB High / Low breakouts", group = G_BRK)
useMid      = input.bool(true, "Trade 50% level breakouts", group = G_BRK)
tolATR      = input.float(0.25, "Retest tolerance (× ATR)", minval = 0, step = 0.05, group = G_BRK,
               tooltip = "How close price must come back to the broken level to count as a retest. Also the buffer used to invalidate a breakout.")
maxWait     = input.int(30, "Max bars to wait for the retest", minval = 1, group = G_BRK)
maxTrades   = input.int(1, "Max signals per session", minval = 1, group = G_BRK,
               tooltip = "Once this many signals have fired, the session is locked: no new breakouts, labels or trades until the next NY open.")
showBreaks  = input.bool(true, "Label breakouts / invalidations", group = G_BRK)

const string G_CNF = "Entry confirmation (any enabled one confirms)"
cFVG        = input.bool(true, "Fair Value Gap retest", group = G_CNF)
cLvl        = input.bool(true, "High / Low level retest (close holds the level)", group = G_CNF)
cRej        = input.bool(true, "Strong rejection candle (pin bar / engulfing)", group = G_CNF)
wickPct     = input.float(0.5, "Rejection: min wick as % of candle", minval = 0.1, maxval = 0.9, step = 0.05, group = G_CNF)
showFVG     = input.bool(true, "Draw breakout FVG", group = G_CNF)

const string G_RSK = "Risk"
entryMode   = input.string("Retest level", "Entry price", options = ["Retest level", "Signal candle close"], group = G_RSK,
               tooltip = "Retest level = the broken ORB level (or the FVG edge for FVG entries). Signal candle close = close of the confirmation candle.")
slMode      = input.string("Retest candle", "Stop loss", options = ["Retest candle", "Opposite ORB side", "ORB 50%"], group = G_RSK,
               tooltip = "Retest candle = beyond the high (shorts) / low (longs) of the retest candles. Opposite ORB side = ORB High for shorts, ORB Low for longs.")
slBufATR    = input.float(0.1, "SL buffer (× ATR)", minval = 0, step = 0.05, group = G_RSK)
rr          = input.float(2.0, "Take profit (R multiple)", minval = 0.1, step = 0.25, group = G_RSK)
tradeBars   = input.int(30, "Trade line length (bars)", minval = 5, maxval = 400, group = G_RSK)
showTrade   = input.bool(true, "Draw entry / SL / TP", group = G_RSK)
showTable   = input.bool(true, "Show info table", group = G_RSK)

// Colours
const color C_ENTRY = #2962FF   // blue
const color C_SL    = #F23645   // red
const color C_TP    = #089981   // green
const color C_BRK   = #9C27B0   // purple

// ───────────────────────────── Time ─────────────────────────────
atr       = ta.atr(14)
tfSec     = timeframe.in_seconds()
tfMs      = tfSec * 1000
yy        = year(time, tz)
mm        = month(time, tz)
dd        = dayofmonth(time, tz)
sessStart = timestamp(tz, yy, mm, dd, openH, openM)
sigEnd    = timestamp(tz, yy, mm, dd, sigEndH, sigEndM)
lvlEnd    = timestamp(tz, yy, mm, dd, lvlEndH, lvlEndM)
newSess   = time >= sessStart and (na(time[1]) or time[1] < sessStart)
closed    = barstate.isconfirmed

// ───────────────────────────── Drawing storage (per session) ─────────────────────────────
type SessDraw
    array<line>  lines
    array<label> labels
    array<box>   boxes

var array<SessDraw> days = array.new<SessDraw>()

regLine(line l) =>
    if days.size() > 0
        days.last().lines.push(l)
    l

regLabel(label l) =>
    if days.size() > 0
        days.last().labels.push(l)
    l

regBox(box b) =>
    if days.size() > 0
        days.last().boxes.push(b)
    b

if newSess
    days.push(SessDraw.new(array.new<line>(), array.new<label>(), array.new<box>()))
    if days.size() > keepDays
        old = days.shift()
        for l in old.lines
            line.delete(l)
        for l in old.labels
            label.delete(l)
        for b in old.boxes
            box.delete(b)

// ───────────────────────────── ORB object ─────────────────────────────
type ORB
    int   mins
    color col
    bool  show
    bool  valid
    float hi        = na
    float lo        = na
    int   endT      = na
    int   startTime = na
    int   readyBar  = na
    bool  building  = false
    bool  ready     = false

method mid(ORB this) =>
    (this.hi + this.lo) / 2

fits(int mins) =>
    tfSec <= mins * 60 and (mins * 60) % tfSec == 0

var array<ORB> orbs = array.from(ORB.new(1, col1, show1, fits(1)), ORB.new(5, col5, show5, fits(5)), ORB.new(15, col15, show15, fits(15)))

for o in orbs
    if o.valid
        if newSess
            o.hi        := high
            o.lo        := low
            o.endT      := sessStart + o.mins * 60000
            o.startTime := time
            o.building  := true
            o.ready     := false
        else if o.building
            o.hi := math.max(o.hi, high)
            o.lo := math.min(o.lo, low)

        // Lock the range only when its last candle has CLOSED, then draw it once with fixed end points
        if o.building and closed and time_close >= o.endT
            o.building := false
            o.ready    := true
            o.readyBar := bar_index
            if o.show
                if showBox
                    regBox(box.new(o.startTime, o.hi, time_close, o.lo, xloc = xloc.bar_time, border_color = color.new(o.col, 60), bgcolor = color.new(o.col, 88)))
                regLine(line.new(o.startTime, o.hi, lvlEnd, o.hi, xloc = xloc.bar_time, color = o.col, width = 2))
                regLine(line.new(o.startTime, o.lo, lvlEnd, o.lo, xloc = xloc.bar_time, color = o.col, width = 2))
                if showMid
                    regLine(line.new(o.startTime, o.mid(), lvlEnd, o.mid(), xloc = xloc.bar_time, color = color.new(o.col, 30), style = line.style_dashed))
                regLabel(label.new(lvlEnd, o.hi, str.tostring(o.mins) + "m ORB", xloc = xloc.bar_time, style = label.style_label_left,
                                   color = color.new(color.black, 100), textcolor = o.col, size = size.small))

// ───────────────────────────── Signal ORB ─────────────────────────────
selMins = switch signalTF
    "1"  => 1
    "5"  => 5
    "15" => 15
    =>      tfSec == 60 ? 1 : tfSec == 300 ? 5 : 15
sig = selMins == 1 ? orbs.get(0) : selMins == 5 ? orbs.get(1) : orbs.get(2)

// ───────────────────────────── State machine ─────────────────────────────
// state: 0 = watching for breakout, 1 = breakout, waiting for retest confirmation, 2 = in trade
var int    state    = 0
var int    dir      = 0
var float  lvl      = na
var string lvlName  = ""
var int    brkBar   = na
var float  fvgTop   = na
var float  fvgBot   = na
var int    fvgBar   = na
var int    trades   = 0
var float  entry    = na
var float  sl       = na
var float  tp       = na
var int    entryBar = na
// one breakout label per level/direction per session
var bool   lbHiUp   = false
var bool   lbLoDn   = false
var bool   lbMidUp  = false
var bool   lbMidDn  = false

longSig  = false
shortSig = false
tol      = atr * tolATR
buf      = atr * slBufATR
tkr      = syminfo.ticker

if newSess
    state   := 0
    trades  := 0
    lbHiUp  := false
    lbLoDn  := false
    lbMidUp := false
    lbMidDn := false

canSignal = sig.valid and sig.ready and bar_index > sig.readyBar and time >= sessStart and time < sigEnd and trades < maxTrades

// Everything below runs only on closed candles -> no intrabar signals that later disappear
if closed
    // 1) Breakout detection (candle close through the level)
    if state == 0 and canSignal
        hi = sig.hi
        lo = sig.lo
        md = sig.mid()
        int    d = 0
        float  L = na
        string n = ""
        if useHL and close > hi and close[1] <= hi
            d := 1
            L := hi
            n := "ORB High"
        else if useHL and close < lo and close[1] >= lo
            d := -1
            L := lo
            n := "ORB Low"
        else if useMid and close > md and close[1] <= md and close <= hi
            d := 1
            L := md
            n := "ORB 50%"
        else if useMid and close < md and close[1] >= md and close >= lo
            d := -1
            L := md
            n := "ORB 50%"
        if d != 0
            state   := 1
            dir     := d
            lvl     := L
            lvlName := n
            brkBar  := bar_index
            fvgTop  := na
            fvgBot  := na
            fvgBar  := na
            isHi  = n == "ORB High"
            isLo  = n == "ORB Low"
            first = isHi ? not lbHiUp : isLo ? not lbLoDn : d == 1 ? not lbMidUp : not lbMidDn
            if isHi
                lbHiUp := true
            else if isLo
                lbLoDn := true
            else if d == 1
                lbMidUp := true
            else
                lbMidDn := true
            if showBreaks and first
                regLabel(label.new(time, d == 1 ? high : low, (d == 1 ? "↑ " : "↓ ") + n + " break", xloc = xloc.bar_time,
                                   style = d == 1 ? label.style_label_down : label.style_label_up,
                                   color = C_BRK, textcolor = color.white, size = size.tiny))
            alert(tkr + " ORB NY: " + (d == 1 ? "bullish" : "bearish") + " breakout of " + n + " (" + str.tostring(L, format.mintick) + ") — waiting for retest", alert.freq_once_per_bar_close)

    // 2) Retest + confirmation
    else if state == 1 and bar_index > brkBar
        // Track the first FVG printed by the breakout leg
        if na(fvgTop)
            if dir == 1 and low > high[2]
                fvgTop := low
                fvgBot := high[2]
                fvgBar := bar_index
            else if dir == -1 and high < low[2]
                fvgTop := low[2]
                fvgBot := high
                fvgBar := bar_index
            if not na(fvgTop) and showFVG
                regBox(box.new(time[2], fvgTop, time + 5 * tfMs, fvgBot, xloc = xloc.bar_time, border_color = na,
                         bgcolor = color.new(dir == 1 ? C_TP : C_SL, 80), text = "FVG", text_size = size.tiny,
                         text_color = color.new(color.gray, 20), text_halign = text.align_right))

        rng       = high - low
        touchLvl  = dir == 1 ? low <= lvl + tol : high >= lvl - tol
        hold      = dir == 1 ? close > lvl : close < lvl
        dirCandle = dir == 1 ? close > open : close < open
        wick      = dir == 1 ? math.min(open, close) - low : high - math.max(open, close)
        closePos  = rng > 0 ? (dir == 1 ? close - low : high - close) / rng : 0.0
        pinBar    = rng > 0 and wick >= wickPct * rng and closePos >= 0.6
        engulf    = dir == 1 ? close > open and close[1] < open[1] and close >= open[1] and open <= close[1] :
                               close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
        touchFVG  = not na(fvgTop) and bar_index > fvgBar and (dir == 1 ? low <= fvgTop and close > fvgBot : high >= fvgBot and close < fvgTop)

        okFVG   = cFVG and touchFVG and hold and dirCandle
        okRej   = cRej and touchLvl and hold and (pinBar or engulf)
        okLvl   = cLvl and touchLvl and hold and dirCandle
        invalid = dir == 1 ? close < lvl - tol : close > lvl + tol

        if invalid or bar_index - brkBar > maxWait or time >= sigEnd
            state := 0
            if showBreaks
                regLabel(label.new(time, dir == 1 ? low : high, invalid ? "✕ failed" : "✕ no retest", xloc = xloc.bar_time,
                                   style = dir == 1 ? label.style_label_up : label.style_label_down,
                                   color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny))
        else if okFVG or okRej or okLvl
            how = okRej ? (pinBar ? "Rejection wick" : "Engulfing") : okLvl ? "Level retest" : "FVG retest"
            trades   += 1
            state    := 2
            entryBar := bar_index

            // Entry: the broken level (FVG edge for pure FVG entries) or the signal candle close
            fvgOnly = how == "FVG retest"
            entry := entryMode == "Signal candle close" ? close : fvgOnly ? (dir == 1 ? fvgTop : fvgBot) : lvl

            // Stop loss — LONG below, SHORT above the entry
            retestLow  = math.min(low, low[1], entry)
            retestHigh = math.max(high, high[1], entry)
            sl := switch slMode
                "Opposite ORB side" => dir == 1 ? sig.lo - buf    : sig.hi + buf
                "ORB 50%"           => dir == 1 ? sig.mid() - buf : sig.mid() + buf
                =>                     dir == 1 ? retestLow - buf : retestHigh + buf
            risk = dir == 1 ? entry - sl : sl - entry
            if risk <= 0
                sl   := dir == 1 ? retestLow - buf : retestHigh + buf
                risk := dir == 1 ? entry - sl : sl - entry
            if risk <= 0
                risk := math.max(atr * 0.5, syminfo.mintick)
                sl   := dir == 1 ? entry - risk : entry + risk

            // Take profit — LONG: entry + R×risk (above), SHORT: entry − R×risk (below)
            tp := dir == 1 ? entry + rr * risk : entry - rr * risk

            longSig  := dir == 1
            shortSig := dir == -1
            regLabel(label.new(time, dir == 1 ? low : high, (dir == 1 ? "LONG" : "SHORT") + "\n" + lvlName + "\n" + how, xloc = xloc.bar_time,
                               style = dir == 1 ? label.style_label_up : label.style_label_down,
                               color = dir == 1 ? C_TP : C_SL, textcolor = color.white, size = size.small))
            if showTrade
                x1 = time
                x2 = math.max(math.min(time + tradeBars * tfMs, lvlEnd), time + tfMs)
                regLine(line.new(x1, entry, x2, entry, xloc = xloc.bar_time, color = C_ENTRY, width = 2))
                regLine(line.new(x1, sl,    x2, sl,    xloc = xloc.bar_time, color = C_SL,    width = 2))
                regLine(line.new(x1, tp,    x2, tp,    xloc = xloc.bar_time, color = C_TP,    width = 2))
                regLabel(label.new(x2, entry, "Entry " + str.tostring(entry, format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                                   color = color.new(C_ENTRY, 20), textcolor = color.white, size = size.tiny))
                regLabel(label.new(x2, sl, "SL " + str.tostring(sl, format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                                   color = color.new(C_SL, 20), textcolor = color.white, size = size.tiny))
                regLabel(label.new(x2, tp, "TP " + str.tostring(rr) + "R " + str.tostring(tp, format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                                   color = color.new(C_TP, 20), textcolor = color.white, size = size.tiny))
            alert(tkr + " ORB NY: " + (dir == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(entry, format.mintick) + " | " + lvlName + " " + how +
                  " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

    // 3) Trade management (SL is checked first when both are hit in the same bar)
    else if state == 2 and bar_index > entryBar
        hitSL  = dir == 1 ? low <= sl : high >= sl
        hitTP  = dir == 1 ? high >= tp : low <= tp
        timeUp = time_close >= lvlEnd
        if hitSL or hitTP or timeUp
            state := 0
            res = hitSL ? "SL hit" : hitTP ? "TP " + str.tostring(rr) + "R hit" : "Time exit"
            regLabel(label.new(time, hitSL ? sl : hitTP ? tp : close, res, xloc = xloc.bar_time, style = label.style_label_left,
                               color = color.new(hitSL ? C_SL : hitTP ? C_TP : color.gray, 30), textcolor = color.white, size = size.tiny))
            alert(tkr + " ORB NY: " + res, alert.freq_once_per_bar_close)

alertcondition(longSig,  "ORB NY Long",  "ORB NY: LONG entry confirmed on retest")
alertcondition(shortSig, "ORB NY Short", "ORB NY: SHORT entry confirmed on retest")

// ───────────────────────────── Info table ─────────────────────────────
var table tb = table.new(position.top_right, 4, 5, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.new(color.gray, 70))
if barstate.isfirst
    table.merge_cells(tb, 0, 4, 3, 4)
if showTable and barstate.islast
    txt = color.white
    table.cell(tb, 0, 0, "ORB",  text_color = txt, text_size = size.small)
    table.cell(tb, 1, 0, "High", text_color = txt, text_size = size.small)
    table.cell(tb, 2, 0, "50%",  text_color = txt, text_size = size.small)
    table.cell(tb, 3, 0, "Low",  text_color = txt, text_size = size.small)
    for [i, o] in orbs
        r   = i + 1
        has = o.valid and o.ready
        table.cell(tb, 0, r, str.tostring(o.mins) + "m" + (o.mins == selMins ? " ★" : ""), text_color = o.col, text_size = size.small)
        table.cell(tb, 1, r, has ? str.tostring(o.hi,    format.mintick) : o.valid ? "…" : "n/a", text_color = txt, text_size = size.small)
        table.cell(tb, 2, r, has ? str.tostring(o.mid(), format.mintick) : o.valid ? "…" : "n/a", text_color = txt, text_size = size.small)
        table.cell(tb, 3, r, has ? str.tostring(o.lo,    format.mintick) : o.valid ? "…" : "n/a", text_color = txt, text_size = size.small)
    status = not sig.valid ? "Chart TF too high for " + str.tostring(selMins) + "m ORB" :
             state == 1 ? (dir == 1 ? "↑ " : "↓ ") + lvlName + " broken — waiting for retest" :
             state == 2 ? (dir == 1 ? "In LONG" : "In SHORT") + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick) :
             trades >= maxTrades ? "Session locked (" + str.tostring(trades) + "/" + str.tostring(maxTrades) + " signals)" :
             "Watching for breakout (" + str.tostring(trades) + "/" + str.tostring(maxTrades) + " today)"
    table.cell(tb, 0, 4, status, text_color = txt, text_size = size.small)
